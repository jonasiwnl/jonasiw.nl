---
import "../styles/index.css";
import Header from "../components/Header.astro";

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description">
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/ico" href="/favicon.ico" />
		<meta name="theme-color" content="#faf3e3" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:inline>html { background-color: #faf3e3; }</style>
	</head>
	<body>
		<canvas class="flow-field flow-field--left" aria-hidden="true"></canvas>
		<canvas class="flow-field flow-field--right" aria-hidden="true"></canvas>
		<main>
			<Header />
			<slot />
		</main>
	</body>
</html>
<script>
	import { createNoise3D } from 'simplex-noise';

	const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

	function currentTheme() {
		return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
	}

	function updateThemeButton(button: HTMLButtonElement) {
		button.setAttribute('aria-pressed', String(currentTheme() === 'light'));
	}

	themeButtons.forEach((button) => {
		updateThemeButton(button);
		button.addEventListener('click', () => {
			const nextTheme = currentTheme() === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = nextTheme;
			updateThemeButton(button);
			window.dispatchEvent(new Event('themechange'));
		});
	});

	const fields = document.querySelectorAll<HTMLCanvasElement>('.flow-field');
	const pageSeed = crypto.getRandomValues(new Uint32Array(1))[0];
	const noise3D = createNoise3D(createRandom(pageSeed));

	fields.forEach((canvas, fieldIndex) => {
		const context = canvas.getContext('2d');
		if (!context) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const fieldSeed = pageSeed + fieldIndex;
		let palette: string[] = [];
		let width = 0;
		let height = 0;
		let offsetX = 0;
		let animationFrame = 0;

		function updateColors() {
			const styles = getComputedStyle(document.documentElement);
			palette = ['--p-color', '--pa-color', '--h2-color', '--card-color']
				.map((property) => styles.getPropertyValue(property).trim());
			palette.push(`rgb(${styles.getPropertyValue('--accent').trim()})`);
		}

		function resize() {
			const bounds = canvas.getBoundingClientRect();
			const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
			width = bounds.width;
			height = bounds.height;
			offsetX = bounds.left;
			canvas.width = Math.floor(width * pixelRatio);
			canvas.height = Math.floor(height * pixelRatio);
			context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
			cancelAnimationFrame(animationFrame);
			draw(performance.now());
		}

		function draw(frameTime: number) {
			context.clearRect(0, 0, width, height);
			if (width < 30 || height < 30) return;

			const random = createRandom(fieldSeed);
			const paths = palette.map(() => new Path2D());
			const spacing = 9.5;
			const time = reducedMotion.matches ? 0 : frameTime * 0.00003;
			const phase = (pageSeed % 6283) / 1000;
			let bandRows = 0;
			let color = 0;

			for (let row = -280; row < height + 280; row += spacing) {
				if (bandRows-- <= 0) {
					const colorRoll = random();
					color = colorRoll < 0.55 ? 0 : colorRoll < 0.8 ? 1 : colorRoll < 0.92 ? 2 : 3;
					bandRows = 1 + Math.floor(random() * 6);
				}
				const accentStart = random() < 0.16 ? random() * width : -100;
				const accentLength = 20 + random() * 45;
				const accentColor = random() < 0.8 ? 4 : 2;
				const stagger = random() * spacing;

				for (let column = 12 + stagger; column < width - 12; column += spacing) {
					const globalX = offsetX + column;
					const x = column + (random() - 0.5) * 0.9;
					const y = row + Math.sin(globalX * 0.0024 + phase + time * 0.25) * 190
						+ noise3D(globalX * 0.0017, row * 0.00065, time) * 65
						+ (random() - 0.5) * 0.9;
					const radius = 3.1 + random() * 0.6;
					if (y < 12 || y > height - 12) continue;
					const path = paths[column >= accentStart && column < accentStart + accentLength ? accentColor : color];
					path.moveTo(x + radius, y);
					path.arc(x, y, radius, 0, Math.PI * 2);
				}
			}

			paths.forEach((path, index) => {
				context.fillStyle = palette[index];
				context.fill(path);
			});
			if (!reducedMotion.matches) animationFrame = requestAnimationFrame(draw);
		}

		updateColors();
		resize();
		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(canvas);
		window.addEventListener('themechange', () => {
			updateColors();
			if (reducedMotion.matches) draw(performance.now());
		});
		reducedMotion.addEventListener('change', () => {
			cancelAnimationFrame(animationFrame);
			draw(performance.now());
		});
	});

	function createRandom(seed: number) {
		return () => {
			seed |= 0;
			seed = (seed + 0x6d2b79f5) | 0;
			let value = Math.imul(seed ^ (seed >>> 15), 1 | seed);
			value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value;
			return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
		};
	}
</script>
<style is:global>
	:root {
		--accent: 93, 126, 150;
		--background-color: #faf3e3;
		--accent-gradient: linear-gradient(45deg, #557664, var(--background-color) 30%, var(--pa-color) 60%);
		--p-color: #46677e;
		--pa-color: #a35a5e;
		--h2-color: #557664;
		--card-color: #e2e6dc;
		--toggle-button-shift: 0px;
	}

	[data-theme='dark'] {
		--accent: 205, 221, 228;
		--background-color: #111217;
		--accent-gradient: linear-gradient(45deg, rgb(var(--accent)), var(--background-color) 30%, #bebebe 60%);
		--p-color: #bebebe;
		--pa-color: #838080;
		--h2-color: #dadada;
		--card-color: #45474f;
	}

	html {
		background-color: var(--background-color);
		scroll-behavior: smooth;
		transition: background-color 0.25s ease;
	}

	.flow-field {
		position: fixed;
		top: 0;
		height: 100vh;
		height: 100dvh;
		width: max(0px, calc(50% - min(325px, 40%) - 6rem));
		pointer-events: none;
		z-index: 0;
	}

	.flow-field--left {
		left: 0;
	}

	.flow-field--right {
		right: 0;
	}

	main {
		position: relative;
		z-index: 1;
	}
</style>
